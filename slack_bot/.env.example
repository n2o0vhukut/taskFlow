JST_MINUTE=0

# Server
PORT=3000
LOG_LEVEL=INFO
SPOOL_DIR=slack_bot/spool

# OpenAI (optional for AI organize)
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1
OPENAI_MAX_TOKENS=1200
MAX_USD_LIMIT=20.0
