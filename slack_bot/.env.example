# Slack
SLACK_BOT_TOKEN=xoxb-xxxx
SLACK_SIGNING_SECRET=xxxx

# TaskFlow
TASKFLOW_API_BASE_URL=http://127.0.0.1:8000
TASKFLOW_API_TOKEN=dev-token

# Users and schedule
DAILY_USER_IDS=U01234567
USER_MAP_JSON={"U01234567":"masato"}
